# Discord bot credentials (never commit real values)
DISCORD_TOKEN=
GUILD_ID=
CLIENT_ID=

# YouTube — Guardians Guild
# Resolve channel ID: npm run resolve-youtube
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@GuardiansGuildX

# Socials — Guardians Guild
FACEBOOK_URL=https://www.facebook.com/GuardiansGuildX
INSTAGRAM_URL=https://www.instagram.com/guardiansguildx/

# Channel name targets (matched by normalized name)
WELCOME_CHANNEL_NAME=welcome
YOUTUBE_ANNOUNCE_CHANNEL=youtube-updates
SUGGEST_CHANNEL_NAME=video-suggestions
MOD_LOG_CHANNEL_NAME=mod-logs

# Feature toggles — disable if another bot already handles these
ENABLE_WELCOME=true
ENABLE_YOUTUBE=true
ENABLE_MOD_LOG=true
ENABLE_AUTO_ROLE=true

# YouTube poll interval (minutes)
YOUTUBE_POLL_MINUTES=15

# Role names used by runtime features
NEW_MEMBER_ROLE_NAME=New Member
MEMBER_ROLE_NAME=Member
