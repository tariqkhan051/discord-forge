  "permissionProfiles": {
    "public": {
      "everyone": {
        "allow": ["ViewChannel", "SendMessages", "EmbedLinks", "AttachFiles", "AddReactions", "UseExternalEmojis", "ReadMessageHistory", "Connect", "Speak"],
        "deny": ["MentionEveryone", "ManageMessages", "ManageChannels"]
      }
    },
    "readonly": {
      "everyone": {
        "allow": ["ViewChannel", "ReadMessageHistory", "AddReactions"],
        "deny": ["SendMessages", "MentionEveryone", "ManageMessages"]
      },
      "staffCanSend": true
    },
    "announce": {
      "everyone": {
        "allow": ["ViewChannel", "ReadMessageHistory", "AddReactions"],
        "deny": ["SendMessages", "MentionEveryone", "ManageMessages"]
      },
      "staffCanSend": true
    },
    "voice": {
      "everyone": {
        "allow": ["ViewChannel", "Connect", "Speak", "UseVAD", "Stream"],
        "deny": []
      }
    },
    "staff": {
      "everyone": {
        "allow": [],
        "deny": ["ViewChannel"]
      },
      "staffOnly": true
    },
    "admin": {
      "everyone": {
        "allow": [],
        "deny": ["ViewChannel"]
      },
      "adminOnly": true
    }
  }
